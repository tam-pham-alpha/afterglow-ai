OBSERVER_PORT=3200
HEALTH_PORT=3201
INGEST_PORT=3202
OBSERVER_URL=http://127.0.0.1:3200
INGEST_PUBLIC_URL=http://127.0.0.1:3202
# Optional. If empty, ingest creates a smee.io channel for local GitHub webhooks.
AFTERGLOW_WEBHOOK_URL=
# Optional override. Otherwise observer reads .data/github.json after Connect.
GITHUB_WEBHOOK_SECRET=
AFTERGLOW_DATA_DIR=.data
